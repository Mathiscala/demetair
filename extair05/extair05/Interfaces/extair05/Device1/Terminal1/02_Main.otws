        <Field Type="Text" Name="Text_6" Row="7" Column="0" Content="Show mask time" />
      </Fields>
      <KeyBindings>
        <KeyBinding Key="ENTER" BindOn="Lang_UP" />
        <KeyBinding Key="ESC" BindOn="GotoMain" />
      </KeyBindings>
    </Mask>
  </Loop>
